# Copia este archivo a .env para desarrollo local. .env está en .gitignore.
# En Netlify, estas variables van en Project configuration → Environment
# variables, con scope de Builds y Functions.

# --- Sesión ---------------------------------------------------------------
# No hay secreto que configurar. La sesión se valida preguntándole a Identity
# (GET /.netlify/identity/user), no comprobando la firma del JWT en local, así
# que la aplicación no necesita conocer la llave con la que GoTrue firma.

# Opcional: exige que el usuario tenga este rol para entrar al registro.
# NETLIFY_IDENTITY_REQUIRED_ROLE=taller

# Opcional: "dev-bypass" entra sin cuenta. Bloqueado por código en producción.
# AUTH_PROVIDER=dev-bypass

# --- Base de datos --------------------------------------------------------
# No hay nada que configurar: Netlify Database inyecta la cadena en
# NETLIFY_DB_URL, tanto en el sitio desplegado como bajo `netlify dev`.

# --- Emisor de la factura -------------------------------------------------
# Fuera del código a propósito: incluyen el RUC y la cuenta bancaria.
# Las listas se separan con "|".
BUSINESS_LEGAL_NAME=
BUSINESS_TAX_ID=
BUSINESS_ADDRESS=Calle y local | Ciudad · País
BUSINESS_EMAIL=
BUSINESS_PHONE=
BUSINESS_WEBSITE=
BUSINESS_PAYMENT_METHODS=Efectivo | Tarjeta de crédito/débito | Transferencia bancaria
